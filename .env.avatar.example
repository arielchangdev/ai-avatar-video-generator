# AI Avatar Video Generator - environment configuration template.
# Copy to `.env.avatar` and adjust paths for your machine.
# Read by config/settings.py (AvatarSettings). Field names are case-insensitive.

# Where generated videos and per-task artifacts are written.
AVATAR_OUTPUT_DIR=C:\path\to\ai-avatar-output

# Redis (Celery broker + task state). Local Redis on the default port.
REDIS_URL=redis://localhost:6379/0

# Directory containing AI model weights (GPT-SoVITS, SadTalker, InsightFace).
MODEL_DIR=C:\path\to\ai-avatar-output\models
